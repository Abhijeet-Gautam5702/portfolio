---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Privacy"
  description="Privacy and analytics information for abhijeetgautam.in."
>
  <section class="page-hero">
    <p class="eyebrow">Privacy</p>
    <h1>
      A small site with <span class="heading-highlight">minimal tracking</span>.
    </h1>
  </section>
  <section class="article-layout">
    <div class="article-body prose prose-zinc max-w-none">
      <p>
        This website does not use advertising, authentication, or a user
        database.
      </p>
      <h2>Analytics</h2>
      <p>
        Cloudflare Web Analytics collects privacy-focused, aggregated usage
        information such as page views, country, device category, and traffic
        source to help understand which writing is useful. Google Analytics may
        also collect anonymous usage information when a measurement ID is
        configured.
      </p>
      <h2>External links</h2>
      <p>
        Links to GitHub, LinkedIn, X, and archived blog posts lead to services
        with their own privacy policies.
      </p>
      <h2>Contact</h2>
      <p>
        Questions can be sent to <a href="mailto:abhijeetgautam572@gmail.com"
          >abhijeetgautam572@gmail.com</a
        >.
      </p>
    </div>
  </section>
</BaseLayout>
