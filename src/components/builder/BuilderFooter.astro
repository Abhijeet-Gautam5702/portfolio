---
const xProfile = "https://x.com/abhijeet_gautam";
---

<footer class="site-footer builder-footer">
  <div class="footer-mark" aria-hidden="true">✦</div>
  <nav class="builder-social" aria-label="Social media">
    <span>Social media</span>
    <a href={xProfile} target="_blank" rel="noopener noreferrer">X</a>
  </nav>
  <div class="footer-meta">
    <p>Built with curiosity</p>
    <span class="footer-dot"></span>
    <p>© {new Date().getFullYear()} Abhijeet Gautam</p>
  </div>
</footer>

<style>
  .builder-footer .footer-mark {
    color: var(--accent);
    font-family: inherit;
    font-size: 2rem;
    letter-spacing: 0;
  }

  .builder-social {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    margin-bottom: 1rem;
  }

  .builder-social span {
    color: var(--label);
    font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
    font-size: 0.7rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .builder-social a {
    color: var(--text);
    font-size: 0.9rem;
    font-weight: 650;
    text-decoration: underline;
    text-decoration-color: currentColor;
    text-underline-offset: 0.2em;
    transition: color 160ms ease, text-decoration-color 160ms ease;
  }

  .builder-social a:hover,
  .builder-social a:focus-visible {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }
</style>
