---
import Icon from "../common/Icon.astro";
import ThemeToggle from "../common/ThemeToggle.astro";

const nav = [
  { label: "Home", href: "/builder/home" },
  { label: "Goals", href: "/builder/goals" },
] as const;

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/builder/home"
    ? pathname === "/builder" || pathname === "/builder/" || pathname === href
    : pathname.startsWith(href);
---

<header class="site-header" data-builder-header>
  <div class="profile-switcher" data-builder-profile-switcher>
    <button
      class="brand profile-trigger"
      type="button"
      aria-expanded="false"
      aria-controls="builder-profile-menu"
      aria-label="Switch profile"
      data-builder-profile-trigger
    >
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 17 17" fill="none">
          <path
            d="M7.03.8c.21-1.07 1.74-1.07 1.96 0l.92 4.52c.08.4.39.7.78.78l4.52.93c1.07.21 1.07 1.74 0 1.96l-4.52.92c-.39.08-.7.39-.78.78l-.92 4.52c-.22 1.07-1.75 1.07-1.96 0L6.1 10.7a1 1 0 0 0-.78-.78L.8 8.99c-1.07-.22-1.07-1.75 0-1.96l4.52-.93a1 1 0 0 0 .78-.78z"
            fill="currentColor"></path>
        </svg>
      </span>
      <span class="brand-name">
        <span class="brand-name-full">Abhijeet Gautam</span>
        <span class="brand-name-short">Abhijeet</span>
      </span>
      <span class="brand-role">/ Product Builder</span>
      <svg class="profile-caret" aria-hidden="true" viewBox="0 0 12 8" fill="none">
        <path d="m1 1.25 5 5 5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </button>

    <div class="profile-menu" id="builder-profile-menu" role="menu" hidden data-builder-profile-menu>
      <a class="profile-option" href="/engineer/home" role="menuitem">Abhijeet / Engineer</a>
      <a class="profile-option active" href="/builder/home" role="menuitem">Abhijeet / Product Builder</a>
    </div>
  </div>

  <nav class="desktop-nav" aria-label="Builder navigation">
    {nav.map((item) => (
      <a class:list={[{ active: isActive(item.href) }]} href={item.href}>
        {item.label}
      </a>
    ))}
    <ThemeToggle />
  </nav>

  <button
    class="nav-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="builder-mobile-navigation"
    aria-label="Open navigation"
    data-builder-nav-toggle
  >
    <span class="menu-icon"><Icon name="menu" size={28} /></span>
    <span class="close-icon"><Icon name="close" size={28} /></span>
  </button>
</header>

<div class="mobile-nav-overlay" data-builder-nav-overlay></div>
<div
  class="mobile-nav-panel"
  id="builder-mobile-navigation"
  aria-hidden="true"
  data-builder-nav-panel
>
  <nav aria-label="Builder navigation">
    {nav.map((item) => (
      <a class:list={["mobile-nav-link", { active: isActive(item.href) }]} href={item.href}>
        {item.label}
      </a>
    ))}
    <div class="mobile-theme-row">
      <span>Color theme</span>
      <ThemeToggle />
    </div>
  </nav>
</div>

<script>
  const header = document.querySelector("[data-builder-header]");
  const toggle = document.querySelector("[data-builder-nav-toggle]");
  const panel = document.querySelector("[data-builder-nav-panel]");
  const overlay = document.querySelector("[data-builder-nav-overlay]");
  const profileSwitcher = document.querySelector("[data-builder-profile-switcher]");
  const profileTrigger = document.querySelector("[data-builder-profile-trigger]");
  const profileMenu = document.querySelector("[data-builder-profile-menu]");

  const closeMenu = () => {
    document.body.classList.remove("nav-open");
    toggle?.setAttribute("aria-expanded", "false");
    toggle?.setAttribute("aria-label", "Open navigation");
    panel?.setAttribute("aria-hidden", "true");
  };

  const closeProfileMenu = () => {
    profileTrigger?.setAttribute("aria-expanded", "false");
    profileMenu?.setAttribute("hidden", "");
  };

  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    if (open) closeMenu();
    else {
      document.body.classList.add("nav-open");
      toggle.setAttribute("aria-expanded", "true");
      toggle.setAttribute("aria-label", "Close navigation");
      panel?.setAttribute("aria-hidden", "false");
    }
  });

  overlay?.addEventListener("click", closeMenu);
  profileTrigger?.addEventListener("click", () => {
    const open = profileTrigger.getAttribute("aria-expanded") === "true";
    if (open) closeProfileMenu();
    else {
      profileTrigger.setAttribute("aria-expanded", "true");
      profileMenu?.removeAttribute("hidden");
    }
  });
  document.addEventListener("click", (event) => {
    if (!profileSwitcher?.contains(event.target as Node)) closeProfileMenu();
  });
  window.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      closeMenu();
      closeProfileMenu();
    }
  });
  window.addEventListener("scroll", () => {
    header?.classList.toggle("scrolled", window.scrollY > 8);
  }, { passive: true });
</script>

<style>
  .profile-switcher { position: relative; }
  .profile-trigger { padding: 0; border: 0; background: transparent; cursor: pointer; }
  .profile-caret { width: .58rem; height: .4rem; margin-left: -.08rem; flex: 0 0 auto; color: var(--muted); transform: translateY(.12rem); transition: transform 180ms ease; }
  .profile-trigger[aria-expanded="true"] .profile-caret { transform: translateY(.12rem) rotate(180deg); }
  .profile-menu { position: absolute; top: calc(100% + .65rem); left: 0; z-index: 80; width: max-content; min-width: 13.5rem; padding: .35rem; border: 1px solid var(--line); border-radius: .85rem; background: color-mix(in srgb, var(--paper) 96%, transparent); box-shadow: 0 14px 32px rgb(15 23 42 / 14%); backdrop-filter: blur(14px); }
  .profile-option { display: block; padding: .7rem .8rem; border-radius: .55rem; color: var(--muted); font-size: .9rem; font-weight: 560; text-decoration: none; transition: background-color 160ms ease, color 160ms ease; }
  .profile-option:hover, .profile-option:focus-visible { background: var(--paper-soft); color: var(--text); }
  .profile-option.active { color: var(--text); }
  .brand-name-short { display: none; }
  @media (max-width: 760px) {
    .brand-name-full { display: none; }
    .brand-name-short { display: inline; }
  }
</style>
